<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sync P2P en la LAN (Fase 5). ACCESS_WIFI_STATE + CHANGE_WIFI_MULTICAST_STATE
         son para el MulticastLock que necesita mDNS: sin el, el Wi-Fi descarta
         los paquetes multicast y el descubrimiento no ve nada (ver MainActivity). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Fase 1.3: pedirle al usuario que excluya a Sway de la optimizacion de
         bateria (Settings). Sin esto, Doze/App Standby (y en Samsung, sus
         "sleeping apps" propios) pueden congelar o matar el proceso mientras
         el servicio de audio sigue "sonando" segun la notificacion, y los
         botones de transporte (notificacion, lockscreen, Bluetooth del auto)
         dejan de responder hasta reabrir la app a mano — ver
         NativeAudioRuntime.transport en el plugin. El permiso mismo no pide
         nada por si solo: solo habilita mostrar el dialogo del sistema
         (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/Theme.sway"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- windowSoftInputMode: sin esto el teclado se dibuja ENCIMA del
             webview y escribis a ciegas, con el campo tapado. `adjustResize`
             achica la ventana para que el campo entre en lo que queda visible;
             traerlo al centro lo hace Modal.tsx al enfocarlo.
             configChanges: cada cambio que NO esté listado recrea la Activity, y con
             ella el WebView entero — React remonta de cero y la app parece recién
             abierta (bug 1.5). density/fontScale/navigation/touchscreen/layoutDirection
             son los que faltaban: cambiar el tamaño de letra o la densidad bastaba. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale|navigation|touchscreen|layoutDirection"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:label="${appLabel}"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
